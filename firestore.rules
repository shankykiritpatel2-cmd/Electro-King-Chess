rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to verify if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to verify if requesting user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles collection: users/{uid}
    match /users/{userId} {
      // Only the authenticated account owner can read or write their private profile
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'joinedTimestamp']));
      allow delete: if false;

      // Subcollection: users/{uid}/dailyPuzzles/{date}
      match /dailyPuzzles/{puzzleDate} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: users/{uid}/puzzleStreaks/{streakId}
      match /puzzleStreaks/{streakId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: users/{uid}/matches/{matchId}
      match /matches/{matchId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: users/{uid}/achievements/{achievementId}
      match /achievements/{achievementId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Unique User ID registry: usernames/{username}
    match /usernames/{username} {
      // Anyone can read during signup to check if a username is available
      allow read: if true;
      // Only authenticated users can claim their own username
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Contact Us support submissions: write-only from clients
    match /contactMessages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 2
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5;
      allow read, update, delete: if false;
    }
    
    // Secure fallback: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
