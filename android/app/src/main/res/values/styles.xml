<resources>
    <!-- Base application theme -->
    <style name="Theme.ElectroKing" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor">@color/statusBar</item>
        <item name="android:navigationBarColor">@color/statusBar</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Fullscreen theme -->
    <style name="Theme.ElectroKing.Fullscreen" parent="Theme.ElectroKing">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
