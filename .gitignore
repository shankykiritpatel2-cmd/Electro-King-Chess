# Backup Archives (Enforce no large ZIPs)
*.zip
*.tar
*.tar.gz
*.rar
*.7z
electro-king.zip
electro-king-android.zip

# Operating System & File System Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# Scratch and verification scripts
scratch/

