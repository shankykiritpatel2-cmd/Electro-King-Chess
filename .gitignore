# Android Build Outputs & Gradle Caches
.gradle/
build/
*/build/
android/.gradle/
android/build/
android/app/build/

# Android Studio & IDE Settings
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# Local Android SDK and Environment Configs
local.properties
android/local.properties
.bundle/

